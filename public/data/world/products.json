  "skill": {
    "metrics": [
      {
        "id": "bss",
        "label": "Tercile Brier skill score",
        "short_label": "BSS",
        "description": "How much better the below- and above-normal chances were than always saying one in three. Above 0 beats climatology; 1 is perfect."
      },
      {
        "id": "acc",
        "label": "Anomaly correlation",
        "short_label": "ACC",
        "description": "Correlation between the ensemble-mean anomaly and the observed anomaly across cases. 1 is perfect; 0 is none."
      },
      {
        "id": "crpss",
        "label": "CRPS skill score",
        "short_label": "CRPSS",
        "description": "How much closer the whole bias-corrected ensemble was to what happened than a climatological ensemble. Above 0 beats climatology."
      },
      {
        "id": "msss",
        "label": "Mean-square skill score",
        "short_label": "MSSS",
        "description": "How much smaller the ensemble-mean anomaly error was than the error of forecasting the normal. Above 0 beats climatology."
      }
    ],
